// Place your key bindings in this file to override the defaults
[
    { "key": "ctrl+t", "command": "workbench.action.terminal.toggleTerminal" },
    { "key": "alt+h", "command": "workbench.action.navigateLeft" },
    { "key": "alt+j", "command": "workbench.action.navigateDown" },
    { "key": "alt+k", "command": "workbench.action.navigateUp" },
    { "key": "alt+l", "command": "workbench.action.navigateRight" },
    { "key": "ctrl+alt+l", "command": "workbench.action.splitEditorRight" },
    { "key": "alt+i", "command": "workbench.action.previousEditor" },
    { "key": "alt+o", "command": "workbench.action.nextEditor" },
    { "key": "shift+alt+o", "command": "workbench.action.moveEditorRightInGroup" },
    { "key": "shift+alt+i", "command": "workbench.action.moveEditorLeftInGroup" },
    { "key": "alt+y", "command": "copyRelativeFilePath" },
    {
        "key": "ctrl+[Backslash]",
        "command": "editor.action.commentLine",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "alt+o",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
    },
    {
        "key": "alt+i",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
    }
]
